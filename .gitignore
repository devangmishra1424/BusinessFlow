.venv/
__pycache__/
*.pyc

.env

data/raw/
data/kb/*
!data/kb/.gitkeep
!data/kb/*.md

# Ops-uploaded per-account documents (signed loan agreements, KYC, etc.) --
# real borrower data, unlike data/kb/'s general policy docs which are
# source content meant to be tracked.
data/documents/

*.onnx
*.bin
*.pt
*.gguf

*.wav
*.ogg
*.mp3

# Real, needed test/eval input fixtures -- not generated output, and in
# english_regression's case, only regenerable via a Windows-only SAPI TTS
# script (generate_english_regression_set.py), so a Linux CI runner or any
# fresh clone has no way to produce them itself. Found live: CI passing
# GROQ_API_KEY for the first time let test_pipeline.py's real round-trip
# test actually run, and it failed on a missing sample_speech_en.wav that
# had silently never been committed.
!tests/fixtures/sample_speech.wav
!tests/fixtures/sample_speech_en.wav
!eval/fixtures/english_regression/*.wav

*.egg-info/

# Raw training corpora and Kaggle data dumps -- gigabytes, not source code.
datasets/
kaggle/mucs-test-dataset/
kaggle/training_assets/
kaggle/training_assets.zip
kaggle/downloaded_model/
kaggle/wer-benchmark-kernel/output/
kaggle/splicing_fuel_assets/

# The downloaded fine-tuned Whisper checkpoint (CTranslate2 export) --
# a generated model artifact fetched from Kaggle, not source code.
businessflow-whisper-finetuned.zip
data/models/businessflow-whisper-finetuned/

# Scratch debug output from earlier debugging sessions -- not project content.
debug_wer.txt
kaggle_kernel_log.txt
kaggle_kernel_log_full.txt
prompt_debug.txt
translit_debug.txt
seed_a.log
seed_b.log
seed_c.log

# Local agent-harness dev-server config -- personal to this machine's
# directory layout, not project content.
.claude/
