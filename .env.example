GROQ_API_KEY=
# Optional additional fallback keys, tried in order once the previous one
# hits a rate limit -- ALTERNATE_GROQ_KEY, then ALTERNATE_GROQ_KEY2,
# ALTERNATE_GROQ_KEY3, ... (agent/client.py discovers however many are
# actually set, up to _MAX_FALLBACK_KEY_SUFFIX). Note that Groq's daily
# token quota is scoped to the ACCOUNT/organization, not the individual
# key -- multiple keys under the same account share one quota pool, so
# this only helps if the extra keys are on genuinely separate accounts.
ALTERNATE_GROQ_KEY=
ALTERNATE_GROQ_KEY2=
ALTERNATE_GROQ_KEY3=
ALTERNATE_GROQ_KEY4=

DATABASE_URL=

# Where the borrower-facing chat app (channels/browser_api.py) is really
# reachable -- used only to build a real "pay now" link (tools/
# payment_tools.py's generate_payment_link) that a Telegram reminder or
# the dashboard's own quick action can point to. No real payment
# processor exists to redirect back to, so this is just this project's
# own public URL. Defaults to http://localhost:8000 if unset, so local
# dev works with nothing configured; set to the real deployed domain
# (e.g. https://businessflowai.duckdns.org) in production, or a
# generated link is unreachable from a real phone.
CHAT_APP_BASE_URL=

# Shared secret the ops dashboard API (ops/api.py) requires on every
# request via an "X-API-Key" header -- it serves every borrower's data
# across the whole portfolio, unlike the chat API's per-account keys.
OPS_API_KEY=

# The bot's own token from @BotFather -- required by channels/
# telegram_bot.py and outbound/send.py's actual message delivery. Found
# missing from this file even though the code has required it for a
# while; added now alongside OPS_ALERT_TELEGRAM_CHAT_ID below, which
# reuses the same bot.
TELEGRAM_BOT_TOKEN=

# The bot's public @username (no leading @), from @BotFather -- used only
# to build a real, tappable t.me/<username>?start=... onboarding link on
# the ops dashboard (ops/api.py's _telegram_invite_link). Not a secret;
# leaving it unset just means that link isn't offered.
TELEGRAM_BOT_USERNAME=

# Chat id (a number -- message @userinfobot on Telegram, or check
# getUpdates, to find your own) where scripts/run_eval_monitor.py sends a
# nightly alert if a real eval regression is detected. Optional -- if
# unset, outbound/send.py's send_ops_alert just returns False and the
# monitor's own loud ERROR-level log line (visible via journalctl) is the
# only signal instead.
OPS_ALERT_TELEGRAM_CHAT_ID=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

HF_TOKEN=

KAGGLE_API_TOKEN=
