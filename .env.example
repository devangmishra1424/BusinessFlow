GROQ_API_KEY=
# Optional additional fallback keys, tried in order once the previous one
# hits a rate limit -- ALTERNATE_GROQ_KEY, then ALTERNATE_GROQ_KEY2,
# ALTERNATE_GROQ_KEY3, ... (agent/client.py discovers however many are
# actually set, up to _MAX_FALLBACK_KEY_SUFFIX). Note that Groq's daily
# token quota is scoped to the ACCOUNT/organization, not the individual
# key -- multiple keys under the same account share one quota pool, so
# this only helps if the extra keys are on genuinely separate accounts.
ALTERNATE_GROQ_KEY=
ALTERNATE_GROQ_KEY2=
ALTERNATE_GROQ_KEY3=
ALTERNATE_GROQ_KEY4=

DATABASE_URL=

# Shared secret the ops dashboard API (ops/api.py) requires on every
# request via an "X-API-Key" header -- it serves every borrower's data
# across the whole portfolio, unlike the chat API's per-account keys.
OPS_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

HF_TOKEN=

KAGGLE_API_TOKEN=
